{
  // Compiles the browser entry's import graph with DOM typings and NO Node
  // types, so any Node built-in (Buffer, node:*, process, setImmediate)
  // reaching the browser-safe core fails `npm run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    // ts-proto's generated JSON helpers probe `globalThis.Buffer` at runtime;
    // allow that implicit-any access. Bare `Buffer`, `process` or `node:*`
    // imports are still "cannot find name/module" errors.
    "noImplicitAny": false
  },
  "include": ["src/browser.ts", "src/types/*.d.ts"]
}
