{
  "name": "counter-strike-demo-parser",
  "version": "0.2.0",
  "description": "TypeScript library for parsing CS:GO .dem files. Streaming event-emitter architecture, fully typed, minimal dependencies.",
  "author": "Yaroslav Pakhaliuk",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "main": "./dist/index.cjs",
  "module": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        },
        "require": {
          "types": "./dist/browser.d.cts",
          "default": "./dist/browser.cjs"
        }
      },
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        },
        "require": {
          "types": "./dist/browser.d.cts",
          "default": "./dist/browser.cjs"
        }
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native/binding.gyp",
    "native/src",
    "native/README.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "tsup",
    "build:native": "node-gyp configure --directory native && node-gyp build --directory native",
    "rebuild:native": "node-gyp rebuild --directory native",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json && tsc -p tsconfig.browser.json && tsc -p test/browser/tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:dist": "npm run build && node scripts/smoke-dist.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "generate:proto": "bash scripts/generate-proto.sh",
    "bench": "npx tsx scripts/benchmark.ts",
    "goldens:update": "npx tsx scripts/generate-goldens.ts",
    "cross-validate": "npx tsx scripts/cross-validate.ts",
    "validate:corpus": "npx tsx scripts/validate-corpus.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "node-gyp": "^13.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.0.0",
    "ts-proto": "^1.181.2",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "csgo",
    "counter-strike",
    "demo",
    "parser",
    "dem",
    "replay",
    "valve",
    "source-engine"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yarikleto/counter-strike-demo-parser.git",
    "directory": "."
  },
  "dependencies": {
    "protobufjs": "^8.0.3",
    "snappyjs": "^0.7.0"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/browser.js",
    "./dist/index.cjs": "./dist/browser.cjs"
  }
}
